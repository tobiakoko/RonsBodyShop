# Email transport (Resend). Server-side only; never prefix with VITE_.
RESEND_API_KEY=""
# Verified sender address on your Resend domain.
LEAD_FROM_EMAIL="Ron's Body Shop Website <noreply@ronsbodyshop.net>"

# Spam protection (Cloudflare Turnstile). Optional: when TURNSTILE_SECRET_KEY is
# empty the server skips verification (honeypot still applies).
